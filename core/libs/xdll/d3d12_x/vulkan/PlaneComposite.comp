#version 460

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform sampler2D scene;
layout(set = 0, binding = 1) uniform sampler2D overlay;
layout(set = 0, binding = 2, rgba8) uniform writeonly image2D target;

layout(push_constant, std430) uniform Push {
    uint premultiplied;
} push;

void main() {
    const ivec2 size = imageSize(target);
    const ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (pixel.x >= size.x || pixel.y >= size.y) return;
    const vec2 uv = (vec2(pixel) + 0.5) / vec2(size);
    const vec3 below = textureLod(scene, uv, 0.0).rgb;
    const vec4 above = textureLod(overlay, uv, 0.0);
    const vec3 color = push.premultiplied != 0 ? above.rgb + below * (1.0 - above.a) : mix(below, above.rgb, above.a);
    imageStore(target, pixel, vec4(color, 1.0));
}
